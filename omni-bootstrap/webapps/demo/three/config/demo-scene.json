{
    "scene": {
    "background": "#0a0f1a",
        "fog": { "color": "#0a0f1a", "near": 20, "far": 60 }
},
    "camera": {
    "type": "perspective",
        "fov": 45,
        "position": [12, 8, 14],
        "lookAt": [0, 0, 0],
        "controls": { "damping": 0.08, "autoRotate": true, "autoRotateSpeed": 1.2 }
},
    "render": { "shadow": false },
    "lights": [
    { "type": "ambient", "color": "#404060", "intensity": 1 },
    { "type": "directional", "color": "#ffffff", "intensity": 1.2, "position": [5, 10, 7] },
    { "type": "point", "color": "#4da6ff", "intensity": 0.8, "position": [-5, 5, -5] }
],
    "helpers": {
    "grid": { "size": 30, "divisions": 20, "color": "#4da6ff", "color2": "#2a4a7a", "y": -3 }
},
    "layout": {
    "type": "radial",
        "radius": 5,
        "y": 0,
        "targets": ["m1", "m2", "m3", "m4", "m5", "m6"]
},
    "objects": [
    {
        "id": "core",
        "type": "primitive",
        "geometry": { "type": "sphere", "radius": 0.6, "segments": 32 },
        "material": { "type": "standard", "color": "#4da6ff", "emissive": "#1a5fff", "metalness": 0.6, "roughness": 0.3 },
        "position": [0, 0, 0],
        "label": { "text": "🌐 核心", "offset": [0, 1.2, 0] },
        "data": { "name": "核心引擎", "desc": "负责统一调度" }
    },
    { "id": "m1", "type": "primitive", "geometry": { "type": "sphere", "radius": 0.5 },
        "material": { "type": "phong", "color": "#22c55e" },
        "label": { "text": "⚙️ 框架", "offset": [0, 0.9, 0] },
        "data": { "name": "轻量 Web 框架", "desc": "自研 IoC/MVC + Tomcat" } },
    { "id": "m2", "type": "primitive", "geometry": { "type": "sphere", "radius": 0.5 },
        "material": { "type": "phong", "color": "#f59e0b" },
        "label": { "text": "🗄️ 数据库", "offset": [0, 0.9, 0] },
        "data": { "name": "数据库管理", "desc": "元数据浏览与查询" } },
    { "id": "m3", "type": "primitive", "geometry": { "type": "sphere", "radius": 0.5 },
        "material": { "type": "phong", "color": "#a78bfa" },
        "label": { "text": "📊 代码分析", "offset": [0, 0.9, 0] },
        "data": { "name": "代码分析", "desc": "多线程行数统计" } },
    { "id": "m4", "type": "primitive", "geometry": { "type": "sphere", "radius": 0.5 },
        "material": { "type": "phong", "color": "#ec4899" },
        "label": { "text": "📁 目录管理", "offset": [0, 0.9, 0] },
        "data": { "name": "目录管理", "desc": "虚拟文件系统" } },
    { "id": "m5", "type": "primitive", "geometry": { "type": "sphere", "radius": 0.5 },
        "material": { "type": "phong", "color": "#06b6d4" },
        "label": { "text": "🤖 Agent", "offset": [0, 0.9, 0] },
        "data": { "name": "智能 Agent", "desc": "集成 AI 对话" } },
    { "id": "m6", "type": "primitive", "geometry": { "type": "sphere", "radius": 0.5 },
        "material": { "type": "phong", "color": "#ef4444" },
        "label": { "text": "🔌 API 调试", "offset": [0, 0.9, 0] },
        "data": { "name": "API 调试", "desc": "Swagger 风格" } }
],
    "interactions": {
    "hover": { "type": "emissive", "color": "#ff6b6b" },
    "click": { "type": "panel", "title": "模块详情",
        "content": "<p><strong>{name}</strong></p><p>{desc}</p>" }
},
    "animations": [
    { "target": "core", "type": "rotate", "axis": "y", "speed": 0.008 }
]
}