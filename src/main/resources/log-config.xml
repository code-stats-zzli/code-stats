<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ① 控制台：DEBUG~ERROR 全输出，类全限定名不截断 -->
    <appender name="CONSOLE" class="com.omni.framework.log.appender.ConsoleAppender">
        <layout class="com.omni.framework.log.layout.PatternLayout">
            <param name="pattern"
                   value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger - %msg%n"/>
        </layout>
        <filter class="com.omni.framework.log.filter.LevelRangeFilter">
            <param name="minLevel" value="DEBUG"/>
            <param name="maxLevel" value="ERROR"/>
        </filter>
    </appender>

    <!-- ② 滚动文件：D:/logs/app.log，父目录自动创建 -->
    <appender name="FILE" class="com.omni.framework.log.appender.RollingFileAppender">
        <param name="file" value="D:/logs/app.log"/>
        <param name="maxFileSize" value="10MB"/>
        <param name="maxBackupIndex" value="5"/>
        <layout class="com.omni.framework.log.layout.PatternLayout">
            <param name="pattern"
                   value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger - %msg%n"/>
        </layout>
        <filter class="com.omni.framework.log.filter.LevelRangeFilter">
            <param name="minLevel" value="DEBUG"/>
            <param name="maxLevel" value="ERROR"/>
        </filter>
    </appender>

    <!-- ③ com.omni 业务包：DEBUG 级，additivity=false，必须自己挂 CONSOLE + FILE
         否则 additivity=true 冒泡到 root(INFO) 时，DEBUG 事件会被 root 的 level 过滤掉 -->
    <logger name="com.omni" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- ④ 根：INFO（第三方库不刷屏），也挂 CONSOLE + FILE -->
    <root level="INFO" additivity="true">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>